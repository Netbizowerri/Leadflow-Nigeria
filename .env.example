# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# VITE_SUPABASE_URL: Your Supabase project URL.
# Found in Supabase Dashboard -> Project Settings -> API.
# Example: https://gjqirvjnzounvwptsgzd.supabase.co
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: The public anon/publishable key.
# Found in Supabase Dashboard -> Project Settings -> API.
# This is safe to expose in the browser (RLS protects the data).
VITE_SUPABASE_ANON_KEY=

# VITE_OUTSCRAPER_KEY: Required for Google Maps business search via Outscraper.
# Get your free key at https://outscraper.com (500 free searches/month).
VITE_OUTSCRAPER_KEY=your_outscraper_key_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
